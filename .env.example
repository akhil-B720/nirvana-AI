# NIRVANA - Environment Configuration

# Application
APP_NAME=NIRVANA
APP_ENV=development
DEBUG=True
SECRET_KEY=nirvana_super_secret_development_key_change_in_production_32bytes!
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database Configuration
# In production, use PostgreSQL with PostGIS:
# DATABASE_URL=postgresql+psycopg2://nirvana:nirvana_pass@postgres:5432/nirvana_db
# For self-contained development, SQLite is used automatically if DATABASE_URL is sqlite:
DATABASE_URL=sqlite:///./nirvana.db

# Machine Learning & Storage
MODEL_DIR=./models
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# External Integrations (Optional)
DATA_SOURCE_CONFIG=./config/sources.yaml
MAP_TOKEN=
LLM_API_KEY=
